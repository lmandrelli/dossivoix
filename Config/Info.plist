<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Clés spécifiques à Dossivoix. Les autres clés (nom affiché, version, écran de lancement…)
  sont générées par Xcode à partir des réglages de build (GENERATE_INFOPLIST_FILE).
-->
<plist version="1.0">
<dict>
	<!-- Autorisations, affichées par iOS à la première utilisation. -->
	<key>NFCReaderUsageDescription</key>
	<string>Dossivoix lit et écrit les étiquettes NFC collées sur vos dossiers pour vous en annoncer le nom.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dossivoix utilise le micro uniquement pendant les courtes questions, pour entendre le nom d'un dossier ou votre réponse (oui, non, recommencer). Rien n'est enregistré.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dossivoix transforme votre voix en texte pour comprendre le nom du dossier et vos réponses. La reconnaissance se fait sur l'iPhone lorsque c'est possible ; rien n'est conservé.</string>

	<!-- Variantes de prononciation du nom de l'app pour Siri (vide au départ).
	     Exemple d'entrée à ajouter si Siri comprend mal « Dossivoix » :
	     <dict>
	       <key>INAlternativeAppName</key><string>Dossi voix</string>
	       <key>INAlternativeAppNamePronunciationHint</key><string>dossi voix</string>
	     </dict> -->
	<key>INAlternativeAppNames</key>
	<array/>

	<!-- Tous les iPhone compatibles iOS 17 ont une puce NFC ; l'app n'a pas de sens sans. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>nfc</string>
	</array>

	<!-- Aucun chiffrement autre que celui du système : pas de déclaration d'export. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
