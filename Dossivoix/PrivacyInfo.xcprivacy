<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité de Dossivoix.
  Aucune collecte par le développeur, aucun suivi publicitaire.
  Le framework Speech peut transmettre l'audio à Apple pour la reconnaissance.
  Le partage d'un diagnostic est déclenché et choisi par l'utilisatrice.
  API « à justification » utilisées :
  - UserDefaults (CA92.1) : lecture du réglage « Mode diagnostic » (Settings.bundle),
    propre à l'app et jamais partagé.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
